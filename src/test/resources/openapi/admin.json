{
  "openapi" : "3.1.0",
  "info" : {
    "contact" : {
      "name" : "gkcontas",
      "url" : "https://github.com/gkcontas"
    },
    "description" : "Catalogue of products, published as two public versions and one\nadministrative API.\n\n**v1 is deprecated** and will be removed after 2027-01-01. It returns a\nsingle price field and a single category; v2 returns a money object and a\nlist, and distinguishes physical from digital products.\n",
    "license" : {
      "name" : "MIT",
      "url" : "https://opensource.org/licenses/MIT"
    },
    "title" : "Product Catalogue API",
    "version" : "1.2.0"
  },
  "servers" : [ {
    "url" : "http://localhost:8080",
    "description" : "Local"
  }, {
    "url" : "https://api.example.com",
    "description" : "Production"
  } ],
  "tags" : [ {
    "description" : "Catalogue maintenance. Requires a bearer token.",
    "name" : "Admin"
  } ],
  "paths" : {
    "/api/admin/products" : {
      "post" : {
        "description" : "Adds a product to the catalogue and returns it in the v2 representation.\n\nBeyond the constraints shown in the schema, one conditional rule applies:\n`weightKg` is required when `kind` is `PHYSICAL`, and `downloadUrl` when it is\n`DIGITAL`. No annotation renders that into the schema, so it is stated here.\n",
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateProductRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProductV2"
                }
              }
            },
            "description" : "The product was created"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The payload failed validation"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Missing or invalid bearer token"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Create a product",
        "tags" : [ "Admin" ]
      }
    },
    "/api/admin/products/{id}" : {
      "delete" : {
        "description" : "Removes a product. Returns 204 with no body on success.",
        "operationId" : "delete",
        "parameters" : [ {
          "description" : "Catalogue identifier",
          "example" : 4,
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "The product was removed"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Missing or invalid bearer token"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No product with that id"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Delete a product",
        "tags" : [ "Admin" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateProductRequest" : {
        "type" : "object",
        "description" : "Payload for adding a product to the catalogue",
        "properties" : {
          "categories" : {
            "type" : "array",
            "description" : "Category slugs",
            "example" : [ "peripherals" ],
            "items" : {
              "type" : "string"
            }
          },
          "currency" : {
            "type" : "string",
            "default" : "BRL",
            "description" : "ISO 4217 currency code",
            "example" : "BRL",
            "pattern" : "^[A-Z]{3}$"
          },
          "downloadUrl" : {
            "type" : "string",
            "description" : "Download location, required for digital products",
            "example" : "https://example.com/download/kb-042"
          },
          "kind" : {
            "type" : "string",
            "description" : "Whether the product ships or is downloaded",
            "enum" : [ "PHYSICAL", "DIGITAL" ],
            "example" : "PHYSICAL"
          },
          "name" : {
            "type" : "string",
            "description" : "Display name",
            "example" : "Mechanical keyboard",
            "maxLength" : 120,
            "minLength" : 2
          },
          "price" : {
            "type" : "number",
            "description" : "Price, greater than zero",
            "example" : 450.0,
            "minimum" : 0.01
          },
          "sku" : {
            "type" : "string",
            "description" : "Stock keeping unit, two letters, a hyphen and three digits",
            "example" : "KB-042",
            "minLength" : 1,
            "pattern" : "^[A-Z]{2}-\\d{3}$"
          },
          "weightKg" : {
            "type" : "number",
            "format" : "double",
            "description" : "Shipping weight in kilograms, required for physical products",
            "example" : 1.2
          }
        },
        "required" : [ "kind", "name", "price", "sku" ]
      },
      "DigitalProductV2" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/ProductV2"
        }, {
          "type" : "object",
          "properties" : {
            "categories" : {
              "type" : "array",
              "description" : "Every category the product belongs to",
              "example" : [ "software" ],
              "items" : {
                "type" : "string"
              }
            },
            "discontinued" : {
              "type" : "boolean",
              "description" : "Whether the product is still sold",
              "example" : false
            },
            "downloadUrl" : {
              "type" : "string",
              "format" : "uri",
              "description" : "Where the licence can be downloaded",
              "example" : "https://example.com/download/sw-100"
            },
            "id" : {
              "type" : "integer",
              "format" : "int64",
              "description" : "Catalogue identifier",
              "example" : 3
            },
            "name" : {
              "type" : "string",
              "description" : "Display name",
              "example" : "Design toolkit licence"
            },
            "price" : {
              "$ref" : "#/components/schemas/Money"
            },
            "sku" : {
              "type" : "string",
              "description" : "Stock keeping unit",
              "example" : "SW-100"
            }
          }
        } ],
        "description" : "A product delivered by download"
      },
      "Money" : {
        "type" : "object",
        "description" : "An amount together with the currency it is expressed in",
        "properties" : {
          "amount" : {
            "type" : "number",
            "description" : "Decimal amount",
            "example" : 450.0
          },
          "currency" : {
            "type" : "string",
            "description" : "ISO 4217 code",
            "example" : "BRL",
            "pattern" : "^[A-Z]{3}$"
          }
        }
      },
      "PhysicalProductV2" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/ProductV2"
        }, {
          "type" : "object",
          "properties" : {
            "categories" : {
              "type" : "array",
              "description" : "Every category the product belongs to",
              "example" : [ "peripherals", "input" ],
              "items" : {
                "type" : "string"
              }
            },
            "discontinued" : {
              "type" : "boolean",
              "description" : "Whether the product is still sold",
              "example" : false
            },
            "id" : {
              "type" : "integer",
              "format" : "int64",
              "description" : "Catalogue identifier",
              "example" : 1
            },
            "name" : {
              "type" : "string",
              "description" : "Display name",
              "example" : "Mechanical keyboard"
            },
            "price" : {
              "$ref" : "#/components/schemas/Money"
            },
            "sku" : {
              "type" : "string",
              "description" : "Stock keeping unit",
              "example" : "KB-001"
            },
            "weightKg" : {
              "type" : "number",
              "format" : "double",
              "description" : "Shipping weight in kilograms",
              "example" : 1.2
            }
          }
        } ],
        "description" : "A product that is shipped"
      },
      "ProblemDetail" : {
        "type" : "object",
        "description" : "RFC 7807 problem details",
        "properties" : {
          "detail" : {
            "type" : "string",
            "description" : "Explanation specific to this occurrence",
            "example" : "No product with id 99 exists in the catalogue."
          },
          "errors" : {
            "type" : "array",
            "description" : "Present on validation failures only: one entry per violated constraint. An\nRFC 7807 extension member — the specification allows them, and this is the\nmachine-readable form of what `detail` says in prose.\n",
            "items" : {
              "$ref" : "#/components/schemas/ValidationError"
            }
          },
          "instance" : {
            "type" : "string",
            "description" : "URI of the specific occurrence",
            "example" : "/api/v2/products/99"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "HTTP status code",
            "example" : 404
          },
          "title" : {
            "type" : "string",
            "description" : "Short, human-readable summary",
            "example" : "Product not found"
          },
          "type" : {
            "type" : "string",
            "description" : "A URI identifying the problem type",
            "example" : "about:blank"
          }
        }
      },
      "ProductV2" : {
        "description" : "A catalogue product. The `type` property selects the concrete shape.",
        "discriminator" : {
          "mapping" : {
            "DIGITAL" : "#/components/schemas/DigitalProductV2",
            "PHYSICAL" : "#/components/schemas/PhysicalProductV2"
          },
          "propertyName" : "type"
        },
        "oneOf" : [ {
          "$ref" : "#/components/schemas/PhysicalProductV2"
        }, {
          "$ref" : "#/components/schemas/DigitalProductV2"
        } ],
        "properties" : {
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "type" ]
      },
      "ValidationError" : {
        "type" : "object",
        "description" : "A single violated constraint",
        "properties" : {
          "field" : {
            "type" : "string",
            "description" : "The offending field, or null for a rule spanning several fields",
            "example" : "sku"
          },
          "message" : {
            "type" : "string",
            "description" : "What is wrong with it",
            "example" : "must look like AB-123"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "description" : "Paste the token into Swagger UI's **Authorize** dialog. The demo token is\n`demo-admin-token`.\n",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
