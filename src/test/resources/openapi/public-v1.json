{
  "openapi" : "3.1.0",
  "info" : {
    "contact" : {
      "name" : "gkcontas",
      "url" : "https://github.com/gkcontas"
    },
    "description" : "Catalogue of products, published as two public versions and one\nadministrative API.\n\n**v1 is deprecated** and will be removed after 2027-01-01. It returns a\nsingle price field and a single category; v2 returns a money object and a\nlist, and distinguishes physical from digital products.\n",
    "license" : {
      "name" : "MIT",
      "url" : "https://opensource.org/licenses/MIT"
    },
    "title" : "Product Catalogue API",
    "version" : "1.2.0"
  },
  "servers" : [ {
    "url" : "http://localhost:8080",
    "description" : "Local"
  }, {
    "url" : "https://api.example.com",
    "description" : "Production"
  } ],
  "tags" : [ {
    "description" : "**Deprecated.** Scheduled for removal after 2027-01-01 — migrate to v2.",
    "name" : "Products v1"
  } ],
  "paths" : {
    "/api/v1/products" : {
      "get" : {
        "deprecated" : true,
        "description" : "Returns a flat representation with a single price and a single category.\n\n**Migration:** `GET /api/v2/products` returns `price` as an object with `amount`\nand `currency`, and `categories` as a list. It also distinguishes physical from\ndigital products through the `type` discriminator.\n",
        "operationId" : "list",
        "parameters" : [ {
          "description" : "Zero-based page index",
          "example" : 0,
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "description" : "Number of items per page",
          "example" : 20,
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        }, {
          "description" : "Filter by a category slug",
          "example" : "peripherals",
          "in" : "query",
          "name" : "category",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PagedResponseProductV1"
                }
              }
            },
            "description" : "A page of products"
          }
        },
        "summary" : "List products (deprecated)",
        "tags" : [ "Products v1" ]
      }
    },
    "/api/v1/products/{id}" : {
      "get" : {
        "deprecated" : true,
        "operationId" : "get",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProductV1"
                }
              }
            },
            "description" : "The product"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No product with that id"
          }
        },
        "summary" : "Fetch one product (deprecated)",
        "tags" : [ "Products v1" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "PagedResponseProductV1" : {
        "type" : "object",
        "description" : "A page of results, with the totals needed to build pagination controls",
        "properties" : {
          "content" : {
            "type" : "array",
            "description" : "The items on this page",
            "items" : {
              "$ref" : "#/components/schemas/ProductV1"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Zero-based index of this page",
            "example" : 0
          },
          "size" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Requested page size",
            "example" : 20
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Total number of matching items across all pages",
            "example" : 42
          }
        }
      },
      "ProblemDetail" : {
        "type" : "object",
        "description" : "RFC 7807 problem details",
        "properties" : {
          "detail" : {
            "type" : "string",
            "description" : "Explanation specific to this occurrence",
            "example" : "No product with id 99 exists in the catalogue."
          },
          "errors" : {
            "type" : "array",
            "description" : "Present on validation failures only: one entry per violated constraint. An\nRFC 7807 extension member — the specification allows them, and this is the\nmachine-readable form of what `detail` says in prose.\n",
            "items" : {
              "$ref" : "#/components/schemas/ValidationError"
            }
          },
          "instance" : {
            "type" : "string",
            "description" : "URI of the specific occurrence",
            "example" : "/api/v2/products/99"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "HTTP status code",
            "example" : 404
          },
          "title" : {
            "type" : "string",
            "description" : "Short, human-readable summary",
            "example" : "Product not found"
          },
          "type" : {
            "type" : "string",
            "description" : "A URI identifying the problem type",
            "example" : "about:blank"
          }
        }
      },
      "ProductV1" : {
        "type" : "object",
        "description" : "Flat product representation served by the deprecated v1 API",
        "properties" : {
          "category" : {
            "type" : "string",
            "deprecated" : true,
            "description" : "The first category only. v2 returns the full list.",
            "example" : "peripherals"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Catalogue identifier",
            "example" : 1
          },
          "name" : {
            "type" : "string",
            "description" : "Display name",
            "example" : "Mechanical keyboard"
          },
          "price" : {
            "type" : "number",
            "deprecated" : true,
            "description" : "Price in BRL. v2 replaces this with a money object carrying the currency.",
            "example" : 450.0
          }
        }
      },
      "ValidationError" : {
        "type" : "object",
        "description" : "A single violated constraint",
        "properties" : {
          "field" : {
            "type" : "string",
            "description" : "The offending field, or null for a rule spanning several fields",
            "example" : "sku"
          },
          "message" : {
            "type" : "string",
            "description" : "What is wrong with it",
            "example" : "must look like AB-123"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "description" : "Paste the token into Swagger UI's **Authorize** dialog. The demo token is\n`demo-admin-token`.\n",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
