{
  "openapi" : "3.1.0",
  "info" : {
    "contact" : {
      "name" : "gkcontas",
      "url" : "https://github.com/gkcontas"
    },
    "description" : "Catalogue of products, published as two public versions and one\nadministrative API.\n\n**v1 is deprecated** and will be removed after 2027-01-01. It returns a\nsingle price field and a single category; v2 returns a money object and a\nlist, and distinguishes physical from digital products.\n",
    "license" : {
      "name" : "MIT",
      "url" : "https://opensource.org/licenses/MIT"
    },
    "title" : "Product Catalogue API",
    "version" : "1.2.0"
  },
  "servers" : [ {
    "url" : "http://localhost:8080",
    "description" : "Local"
  }, {
    "url" : "https://api.example.com",
    "description" : "Production"
  } ],
  "tags" : [ {
    "description" : "The current public catalogue API.",
    "name" : "Products v2"
  } ],
  "paths" : {
    "/api/v2/products" : {
      "get" : {
        "description" : "Returns a page of products. Each item carries a `type` discriminator selecting\neither `PhysicalProductV2` or `DigitalProductV2`.\n",
        "operationId" : "list",
        "parameters" : [ {
          "description" : "Zero-based page index",
          "example" : 0,
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "description" : "Number of items per page",
          "example" : 20,
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        }, {
          "description" : "Filter by a category slug",
          "example" : "peripherals",
          "in" : "query",
          "name" : "category",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PagedProductV2"
                }
              }
            },
            "description" : "A page of products"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid paging parameters"
          }
        },
        "summary" : "List products",
        "tags" : [ "Products v2" ]
      }
    },
    "/api/v2/products/{id}" : {
      "get" : {
        "description" : "Inspect the `type` property before reading the shape-specific fields.",
        "operationId" : "get",
        "parameters" : [ {
          "description" : "Catalogue identifier",
          "example" : 1,
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "examples" : {
                  "digital" : {
                    "description" : "digital",
                    "summary" : "A product delivered by download",
                    "value" : {
                      "type" : "DIGITAL",
                      "id" : 3,
                      "name" : "Design toolkit licence",
                      "sku" : "SW-100",
                      "price" : {
                        "amount" : 990.0,
                        "currency" : "BRL"
                      },
                      "categories" : [ "software" ],
                      "discontinued" : false,
                      "downloadUrl" : "https://example.com/download/sw-100"
                    }
                  },
                  "physical" : {
                    "description" : "physical",
                    "summary" : "A product that ships",
                    "value" : {
                      "type" : "PHYSICAL",
                      "id" : 1,
                      "name" : "Mechanical keyboard",
                      "sku" : "KB-001",
                      "price" : {
                        "amount" : 450.0,
                        "currency" : "BRL"
                      },
                      "categories" : [ "peripherals", "input" ],
                      "discontinued" : false,
                      "weightKg" : 1.2
                    }
                  }
                },
                "schema" : {
                  "$ref" : "#/components/schemas/ProductV2"
                }
              }
            },
            "description" : "The product"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No product with that id"
          }
        },
        "summary" : "Fetch one product",
        "tags" : [ "Products v2" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "DigitalProductV2" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/ProductV2"
        }, {
          "type" : "object",
          "properties" : {
            "categories" : {
              "type" : "array",
              "description" : "Every category the product belongs to",
              "example" : [ "software" ],
              "items" : {
                "type" : "string"
              }
            },
            "discontinued" : {
              "type" : "boolean",
              "description" : "Whether the product is still sold",
              "example" : false
            },
            "downloadUrl" : {
              "type" : "string",
              "format" : "uri",
              "description" : "Where the licence can be downloaded",
              "example" : "https://example.com/download/sw-100"
            },
            "id" : {
              "type" : "integer",
              "format" : "int64",
              "description" : "Catalogue identifier",
              "example" : 3
            },
            "name" : {
              "type" : "string",
              "description" : "Display name",
              "example" : "Design toolkit licence"
            },
            "price" : {
              "$ref" : "#/components/schemas/Money"
            },
            "sku" : {
              "type" : "string",
              "description" : "Stock keeping unit",
              "example" : "SW-100"
            }
          }
        } ],
        "description" : "A product delivered by download"
      },
      "Money" : {
        "type" : "object",
        "description" : "An amount together with the currency it is expressed in",
        "properties" : {
          "amount" : {
            "type" : "number",
            "description" : "Decimal amount",
            "example" : 450.0
          },
          "currency" : {
            "type" : "string",
            "description" : "ISO 4217 code",
            "example" : "BRL",
            "pattern" : "^[A-Z]{3}$"
          }
        }
      },
      "PagedProductV2" : {
        "type" : "object",
        "description" : "A page of products",
        "properties" : {
          "content" : {
            "type" : "array",
            "description" : "The products on this page",
            "items" : {
              "$ref" : "#/components/schemas/ProductV2"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Zero-based index of this page",
            "example" : 0
          },
          "size" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Requested page size",
            "example" : 20
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Total number of matching products across all pages",
            "example" : 42
          }
        }
      },
      "PhysicalProductV2" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/ProductV2"
        }, {
          "type" : "object",
          "properties" : {
            "categories" : {
              "type" : "array",
              "description" : "Every category the product belongs to",
              "example" : [ "peripherals", "input" ],
              "items" : {
                "type" : "string"
              }
            },
            "discontinued" : {
              "type" : "boolean",
              "description" : "Whether the product is still sold",
              "example" : false
            },
            "id" : {
              "type" : "integer",
              "format" : "int64",
              "description" : "Catalogue identifier",
              "example" : 1
            },
            "name" : {
              "type" : "string",
              "description" : "Display name",
              "example" : "Mechanical keyboard"
            },
            "price" : {
              "$ref" : "#/components/schemas/Money"
            },
            "sku" : {
              "type" : "string",
              "description" : "Stock keeping unit",
              "example" : "KB-001"
            },
            "weightKg" : {
              "type" : "number",
              "format" : "double",
              "description" : "Shipping weight in kilograms",
              "example" : 1.2
            }
          }
        } ],
        "description" : "A product that is shipped"
      },
      "ProblemDetail" : {
        "type" : "object",
        "description" : "RFC 7807 problem details",
        "properties" : {
          "detail" : {
            "type" : "string",
            "description" : "Explanation specific to this occurrence",
            "example" : "No product with id 99 exists in the catalogue."
          },
          "errors" : {
            "type" : "array",
            "description" : "Present on validation failures only: one entry per violated constraint. An\nRFC 7807 extension member — the specification allows them, and this is the\nmachine-readable form of what `detail` says in prose.\n",
            "items" : {
              "$ref" : "#/components/schemas/ValidationError"
            }
          },
          "instance" : {
            "type" : "string",
            "description" : "URI of the specific occurrence",
            "example" : "/api/v2/products/99"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "HTTP status code",
            "example" : 404
          },
          "title" : {
            "type" : "string",
            "description" : "Short, human-readable summary",
            "example" : "Product not found"
          },
          "type" : {
            "type" : "string",
            "description" : "A URI identifying the problem type",
            "example" : "about:blank"
          }
        }
      },
      "ProductV2" : {
        "description" : "A catalogue product. The `type` property selects the concrete shape.",
        "discriminator" : {
          "mapping" : {
            "DIGITAL" : "#/components/schemas/DigitalProductV2",
            "PHYSICAL" : "#/components/schemas/PhysicalProductV2"
          },
          "propertyName" : "type"
        },
        "oneOf" : [ {
          "$ref" : "#/components/schemas/PhysicalProductV2"
        }, {
          "$ref" : "#/components/schemas/DigitalProductV2"
        } ],
        "properties" : {
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "type" ]
      },
      "ValidationError" : {
        "type" : "object",
        "description" : "A single violated constraint",
        "properties" : {
          "field" : {
            "type" : "string",
            "description" : "The offending field, or null for a rule spanning several fields",
            "example" : "sku"
          },
          "message" : {
            "type" : "string",
            "description" : "What is wrong with it",
            "example" : "must look like AB-123"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "description" : "Paste the token into Swagger UI's **Authorize** dialog. The demo token is\n`demo-admin-token`.\n",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
